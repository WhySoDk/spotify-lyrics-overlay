<UserControl x:Class="spotify_lyrics_overlay.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="60" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="border" CornerRadius="4" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <RepeatButton Grid.Column="0" Style="{StaticResource StepButton}" Content="&#xE738;"
                      Click="decreaseButton_Click" ToolTip="Decrease" />
        <TextBox x:Name="valueBox" Grid.Column="1" Margin="6,0" TextAlignment="Center" VerticalContentAlignment="Center"
                 PreviewTextInput="valueBox_PreviewTextInput" TextChanged="valueBox_TextChanged" LostKeyboardFocus="valueBox_LostKeyboardFocus"
                 PreviewKeyDown="valueBox_PreviewKeyDown" PreviewMouseWheel="valueBox_PreviewMouseWheel" />
        <RepeatButton Grid.Column="2" Style="{StaticResource StepButton}" Content="&#xE710;"
                      Click="increaseButton_Click" ToolTip="Increase" />
    </Grid>
</UserControl>
